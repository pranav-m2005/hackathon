    {
      "name": "top5_products_orders_returns",
      "displayName": "Top 5 Products Orders vs Returns",
      "config": {
        "version": "1.1",
        "source": "WITH per_product AS (\n  SELECT merchant_category AS product,\n         COUNT(*) AS orders,\n         COUNT_IF(return_option = 'Yes') AS returns\n  FROM workspace.hackathon.gold_product\n  GROUP BY merchant_category\n),\nranked AS (\n  SELECT product, orders, returns,\n         ROW_NUMBER() OVER (ORDER BY orders DESC) AS product_rank\n  FROM per_product\n)\nSELECT product, 'Orders' AS metric, orders AS value, product_rank\nFROM ranked WHERE product_rank <= 5\nUNION ALL\nSELECT product, 'Returns' AS metric, returns AS value, product_rank\nFROM ranked WHERE product_rank <= 5\n",
        "dimensions": [
          {
            "name": "product",
            "expr": "product",
            "displayName": "Product"
          },
          {
            "name": "metric",
            "expr": "metric",
            "displayName": "Metric"
          },
          {
            "name": "product_rank",
            "expr": "product_rank"
          }
        ],
        "measures": [
          {
            "name": "total_value",
            "expr": "SUM(value)",
            "displayName": "Count"
          }
        ]
      }
    }
  ],
