        "source": "workspace.hackathon.gold_product",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "total_sales",
            "expr": "SUM(amount_aed)",
            "format": {
              "type": "currency",
              "currencyCode": "AED",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "returns_count",
            "expr": "COUNT_IF(return_option = 'Yes')",
            "displayName": "Returns"
          },
          {
            "name": "return_rate_pct",
            "expr": "try_divide(COUNT_IF(return_option = 'Yes'), COUNT(*))",
            "displayName": "Return Rate %",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "net_sales_after_returns",
            "expr": "SUM(CASE WHEN return_option = 'Yes' THEN 0 ELSE amount_aed END)",
            "format": {
              "type": "currency",
              "currencyCode": "AED",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
